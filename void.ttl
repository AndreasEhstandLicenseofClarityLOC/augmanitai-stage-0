<https://andreasehstandlicenseofclarityloc.github.io/augmanitai-stage-0/#dataset>
    a void:Dataset , dcat:Dataset ;
    dct:title "AUGMANITAI Stage-0 Term Atlas"@en ;
    dct:description "Phenomenological terminology corpus of 1,128 defined terms with SKOS concept graph, Schema.org DefinedTerm pages, and PROV provenance. ISO 704 / 1087 / 30042 aligned."@en ;
    dct:creator <https://orcid.org/0009-0006-3773-7796> ;
    dct:publisher <https://orcid.org/0009-0006-3773-7796> ;
    dct:license <https://creativecommons.org/licenses/by-nc-nd/4.0/> ;
    dct:created "2026-04-01"^^xsd:date ;
    dct:modified "2026-05-15"^^xsd:date ;
    dct:identifier <https://doi.org/10.5281/zenodo.20118267> ;
    dct:conformsTo <https://www.iso.org/standard/38109.html> , # ISO 704
                   <https://www.iso.org/standard/20057.html> , # ISO 1087
                   <https://www.iso.org/standard/62330.html> ; # ISO 30042
    foaf:homepage <https://andreasehstandlicenseofclarityloc.github.io/augmanitai-stage-0/> ;
    owl:sameAs wd:Q138522830 ;
    schema:sameAs <https://doi.org/10.5281/zenodo.20118267> , wd:Q138522830 ;
    void:feature <http://www.w3.org/ns/formats/JSON-LD> ,
                 <http://www.w3.org/ns/formats/Turtle> ;
    void:vocabulary <http://www.w3.org/2004/02/skos/core#> ,
                    <http://schema.org/> ,
                    <http://www.w3.org/ns/prov#> ,
                    <http://purl.org/dc/terms/> ;
    void:rootResource <https://andreasehstandlicenseofclarityloc.github.io/augmanitai-stage-0/atlas/> ;
    void:exampleResource augm:cognitive-continuity-methodology ;
    void:uriSpace "https://andreasehstandlicenseofclarityloc.github.io/augmanitai-stage-0/atlas/" ;
    void:entities 1128 ;
    void:classes 4 ;
    void:properties 18 ;
    void:triples 850000 ;
    void:distinctSubjects 1128 ;
    void:distinctObjects 180000 ;
    # No SPARQL endpoint provided — static-site corpus. Consume via dataDump.
    schema:keywords "terminology, phenomenology, SKOS, DefinedTerm, ISO 704, controlled vocabulary, AUGMANITAI, cognitive science" .

